---
import type { Stats as Props } from '~/types';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import { Icon } from 'astro-icon/components';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  stats = [],

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-6xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <Headline title={title} subtitle={subtitle} tagline={tagline} />
  <div class="grid gap-4 md:gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {
      stats &&
        stats.map(({ amount, title, icon }) => (
          <article class="hta-card field-card rounded-lg p-5 text-center md:p-6 intersect-once motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade intersect-quarter">
            {icon && (
              <div class="hta-icon-badge mx-auto mb-4 !h-12 !w-12">
                <Icon name={icon} class="!h-6 !w-6" />
              </div>
            )}
            {amount && (
              <div class="font-heading text-4xl font-semibold text-[var(--hta-link)] md:text-5xl">{amount}</div>
            )}
            {title && <div class="hta-muted mt-2 text-sm font-semibold uppercase tracking-[0.05em]">{title}</div>}
          </article>
        ))
    }
  </div>
</WidgetWrapper>
