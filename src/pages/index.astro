---
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Button from '~/components/ui/Button.astro';
import ProgramCard from '~/components/ui/ProgramCard.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Heartland Transpersonal Alliance',
  ignoreTitleTemplate: true,
  description:
    'A nonprofit organization fostering community, education, harm reduction, and integration around the safe, responsible exploration of consciousness.',
};

const pillars = [
  {
    label: 'Research-minded education',
    icon: 'tabler:flask-2',
    title: 'Evidence-informed public learning',
    description:
      'HTA creates approachable education around consciousness, psychedelic science, and responsible community care.',
    accent: 'accent-research',
  },
  {
    label: 'Community infrastructure',
    icon: 'tabler:users-group',
    title: 'Programs with local continuity',
    description:
      'Initiatives stay connected through nonprofit governance, shared standards, and Kansas City relationships.',
    accent: 'accent-community',
  },
  {
    label: 'Harm-reduction clarity',
    icon: 'tabler:lifebuoy',
    title: 'Direct safety pathways',
    description:
      'Training, peer support, and overdose-prevention resources make care practical where people actually gather.',
    accent: 'accent-harm-reduction',
  },
];

const pathways = [
  {
    icon: 'tabler:circles-relation',
    title: 'Integration circles',
    description:
      'Confidential peer spaces for making meaning after intense or non-ordinary experiences, grounded in care and discretion.',
    href: 'https://kc-psychedelic.com',
    cta: 'KCPIC',
    accent: 'accent-integration',
  },
  {
    icon: 'tabler:school',
    title: 'Public education',
    description:
      'Talks, community gatherings, and literacy-building events that keep complicated topics practical and accessible.',
    href: 'https://psychedelickc.org',
    cta: 'PSKC',
    accent: 'accent-education',
  },
  {
    icon: 'tabler:shield-heart',
    title: 'Event support',
    description:
      'Harm-reduction training, compassionate presence, and overdose-prevention resources for festivals and live events.',
    href: 'https://safejourneysanctum.org',
    cta: 'SJS',
    accent: 'accent-harm-reduction',
  },
];

const principles = [
  'Community-led infrastructure',
  'Evidence-informed safety practices',
  'Integration after intensity',
];
---

<Layout metadata={metadata}>
  <section class="home-hero not-prose" aria-labelledby="home-title">
    <div class="home-hero-inner">
      <div class="hero-angle" aria-hidden="true"></div>
      <div class="relative max-w-3xl">
        <p class="section-kicker">Kansas City · Community nonprofit</p>
        <h1 id="home-title" class="mt-6">Heartland<br />Transpersonal<br />Alliance</h1>
        <p class="mt-7 max-w-xl text-xl leading-relaxed">
          A community for the exploration of consciousness. Grounded in education, integration, and care.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button variant="primary" href={getPermalink('/initiatives')} icon="tabler:arrow-right"
            >Explore initiatives</Button
          >
          <Button variant="secondary" href={getPermalink('/about')}>About the alliance</Button>
        </div>
      </div>
    </div>
  </section>

  <section class="relative not-prose">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 md:py-16">
      <div class="grid items-start gap-10">
        <div>
          <p class="section-kicker">What HTA Makes Possible</p>
          <h2 class="mt-5 max-w-3xl font-heading text-3xl font-medium leading-[1.15] md:text-4xl">
            Support that connects people, knowledge, and care.
          </h2>
          <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted">
            HTA is the nonprofit home for Kansas City programs that connect education, integration, and field care into
            one responsible community pathway.
          </p>
          <div class="mt-6">
            <Button variant="link" href={getPermalink('/about')} icon="tabler:arrow-right">
              Learn more about HTA
            </Button>
          </div>
        </div>
        <div class="grid gap-5 md:grid-cols-3">
          {
            pillars.map((item) => (
              <ProgramCard
                accent={item.accent}
                icon={item.icon}
                label={item.label}
                title={item.title}
                description={item.description}
                class="p-5 md:p-6"
              />
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section id="focus-areas" class="resource-stripe relative not-prose">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 md:py-16">
      <div class="mb-8 grid items-end gap-6 lg:grid-cols-[0.8fr_1.2fr]">
        <div>
          <p class="section-kicker">Our initiatives</p>
          <h2 class="mt-5 font-heading text-3xl font-medium leading-[1.15] md:text-4xl">Find your way into the work</h2>
        </div>
        <p class="max-w-3xl text-lg leading-relaxed text-muted">
          Inspired by compassionate peer-support models, HTA gives Kansas City trusted programs, trained collaborators,
          and clear access points.
        </p>
      </div>

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          pathways.map((item) => (
            <ProgramCard
              accent={item.accent}
              icon={item.icon}
              title={item.title}
              description={item.description}
              href={item.href}
              cta={item.cta}
              class="min-h-[22rem]"
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="relative not-prose">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 py-16 sm:px-6 lg:grid-cols-2 lg:gap-20 lg:py-24">
      <div>
        <p class="section-kicker">One alliance, shared purpose</p>
        <h2 class="mt-5 font-heading text-3xl font-medium leading-tight md:text-4xl">
          Local relationships.<br />Lasting support.
        </h2>
        <p class="mt-5 max-w-xl text-lg leading-relaxed">
          HTA connects public education, peer integration, and event-based care so community members and partners can
          find the right support at the right moment.
        </p>
        <Button variant="link" href={getPermalink('/board')} icon="tabler:arrow-right" class="mt-6"
          >Meet our board</Button
        >
      </div>
      <ul class="self-center divide-y divide-[var(--hta-border)] border-y border-[var(--hta-border)]">
        {
          principles.map((principle) => (
            <li class="flex items-center gap-4 py-6 text-lg">
              <Icon name="tabler:check" class="h-5 w-5 shrink-0 text-primary" aria-hidden="true" />
              <span>{principle}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <BlogLatestPosts
    title="News & Updates"
    information="Board updates, organizational announcements, and major initiative milestones."
    linkText="View all news"
    count={3}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Apply to the Board',
        href: getPermalink('/board-app'),
      },
      {
        text: 'Contact HTA',
        href: getPermalink('/contact'),
      },
    ]}
    title="Shape HTA"
    subtitle="We are actively building board capacity across community activism, medicine, psychotherapy, social work, and education."
  />
</Layout>
