---
import '~/assets/styles/tailwind.css';

import { I18N } from 'astrowind:config';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import Metadata from '~/components/common/Metadata.astro';
import SiteVerification from '~/components/common/SiteVerification.astro';
import Analytics from '~/components/common/Analytics.astro';
import BasicScripts from '~/components/common/BasicScripts.astro';
import siteTexture from '~/assets/images/hta/hero-image.jpg';

import type { MetaData as MetaDataType } from '~/types';

export interface Props {
  metadata?: MetaDataType;
}

const { metadata = {} } = Astro.props;
const { language, textDirection } = I18N;
---

<!doctype html>
<html lang={language} dir={textDirection} class="2xl:text-[19px]">
  <head>
    <CommonMeta />
    <Favicons />
    <CustomStyles />
    <ApplyColorMode />
    <Metadata {...metadata} />
    <SiteVerification />
    <Analytics />
  </head>

  <body class="antialiased text-default bg-page relative min-h-screen overflow-x-hidden">
    <div class="pointer-events-none fixed inset-0 -z-20" aria-hidden="true">
      <div
        class="absolute inset-0 flow-field dark:bg-[linear-gradient(135deg,rgb(15_46_47),rgb(11_58_117)_58%,rgb(22_75_77))]"
      >
      </div>
      <img
        src={siteTexture.src}
        width={siteTexture.width}
        height={siteTexture.height}
        alt=""
        class="absolute right-[-12vw] top-0 h-[72vh] w-[96vw] object-cover opacity-[0.08] mix-blend-multiply dark:opacity-[0.12] dark:mix-blend-screen"
        loading="eager"
        decoding="async"
      />
      <div class="page-wash absolute inset-0"></div>
      <div class="page-grain absolute inset-0 opacity-[0.08] dark:opacity-[0.05]"></div>
    </div>

    <slot />

    <BasicScripts />
  </body>
</html>
