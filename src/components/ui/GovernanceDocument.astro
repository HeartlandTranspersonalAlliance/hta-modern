---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import { getPermalink } from '~/utils/permalinks';

interface Props {
  title: string;
  category: string;
  description: string;
  sections: { id: string; title: string }[];
  page: 'war-on-drugs' | 'bylaws' | 'code-of-conduct';
}

const { title, category, description, sections, page } = Astro.props;
const related = [
  {
    page: 'war-on-drugs',
    title: 'War on Drugs & Restorative Justice',
    description: 'The U.S. drug war, its effects, and a different approach to accountability.',
  },
  { page: 'bylaws', title: 'Bylaws', description: 'How HTA is governed and how the board makes decisions.' },
  {
    page: 'code-of-conduct',
    title: 'Ethical Code of Conduct',
    description: 'Expectations for conduct, reporting concerns, and responding to harm.',
  },
].filter((item) => item.page !== page);
---

<Layout metadata={{ title, description }}>
  <HeroText tagline={category} title={title} subtitle={description} />

  <section class="relative not-prose py-12 md:py-16" aria-label="Document text">
    <div class="mx-auto grid max-w-7xl gap-6 px-4 sm:px-6 lg:grid-cols-[minmax(0,1fr)_16rem] lg:gap-8">
      <aside class="order-first self-start lg:sticky lg:top-28 lg:order-last">
        <nav aria-label="On this page" class="paper-panel p-5">
          <h2 class="hta-strong font-heading text-lg font-semibold">On this page</h2>
          <ul class="mt-3 grid gap-2" role="list">
            {
              sections.map(({ id, title }) => (
                <li>
                  <a
                    class="hta-focus-ring block rounded px-1 py-1.5 text-sm font-semibold underline underline-offset-4"
                    href={`#${id}`}
                  >
                    {title}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </aside>
      <article class="document-body paper-panel min-w-0 p-5 sm:p-8 lg:p-10">
        <slot />
      </article>
    </div>
  </section>

  <section class="resource-stripe not-prose py-12 md:py-14" aria-labelledby="related-documents">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 id="related-documents" class="hta-section-title">Related reading</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {
          related.map((item) => (
            <article class="paper-panel p-5 sm:p-6">
              <h3 class="hta-strong font-heading text-xl font-semibold">
                <a class="hta-focus-ring rounded underline underline-offset-4" href={getPermalink(`/${item.page}`)}>
                  {item.title}
                </a>
              </h3>
              <p class="mt-2 leading-relaxed text-muted">{item.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .document-body :global(section[id], li[id]) {
    scroll-margin-top: 7rem;
  }
  .document-body :global(section + section) {
    margin-block-start: 2.6rem;
    padding-block-start: 2.3rem;
    border-top: 1px solid var(--hta-border);
  }
  .document-body :global(h2) {
    font-size: clamp(1.35rem, 2.5vw, 2rem);
    line-height: 1.18;
    text-wrap: balance;
  }
  .document-body :global(h3) {
    font-size: 1.2rem;
    line-height: 1.3;
  }
  .document-body :global(p),
  .document-body :global(li) {
    max-width: 66ch;
    line-height: 1.75;
  }
  .document-body :global(p + p),
  .document-body :global(h2 + p),
  .document-body :global(h3 + p),
  .document-body :global(p + h3),
  .document-body :global(p + ul),
  .document-body :global(p + ol),
  .document-body :global(ul + p),
  .document-body :global(ol + p) {
    margin-block-start: 0.9rem;
  }
  .document-body :global(ul:not([role='list'])),
  .document-body :global(ol:not([role='list'])) {
    padding-inline-start: 1.4rem;
  }
  .document-body :global(ul:not([role='list'])) {
    list-style: disc;
  }
  .document-body :global(ol:not([role='list'])) {
    list-style: decimal;
  }
  .document-body :global(a:not(.btn)) {
    overflow-wrap: anywhere;
    color: var(--hta-link);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .document-body :global(a:focus-visible) {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }
</style>
