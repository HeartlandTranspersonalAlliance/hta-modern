---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Support HTA',
};

const support = [
  {
    title: 'Partner',
    description: 'Coordinate on education, public-health, or community programming needs.',
  },
  {
    title: 'Volunteer',
    description: 'Help build practical infrastructure for events, outreach, and nonprofit operations.',
  },
  {
    title: 'Serve',
    description: 'Apply for board service if your background can strengthen HTA governance.',
  },
];
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Support HTA"
    title="Sustainable nonprofit infrastructure"
    subtitle="HTA does not sell pricing plans. This page now points visitors toward partnership, volunteer, and board-service pathways."
  />

  <section class="relative not-prose">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 md:py-16">
      <div class="grid gap-5 md:grid-cols-3">
        {
          support.map((item, index) => (
            <article class="editorial-card resource-card accent-institutional p-6">
              <span class="font-heading text-4xl font-semibold text-[var(--hta-link)]">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h2 class="hta-strong mt-6 font-heading text-2xl font-semibold leading-tight">{item.title}</h2>
              <p class="hta-muted mt-4 text-base leading-7">{item.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CallToAction
    title="Choose a practical next step"
    subtitle="Contact HTA for partnerships or apply directly for board service."
    actions={[
      {
        variant: 'primary',
        text: 'Contact HTA',
        href: getPermalink('/contact'),
      },
      {
        text: 'Apply for Board',
        href: getPermalink('/board-app'),
      },
    ]}
  />
</Layout>
