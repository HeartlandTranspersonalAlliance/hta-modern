---
import Layout from '~/layouts/PageLayout.astro';
import { getHomePermalink } from '~/utils/permalinks';

const title = `Error 404`;
---

<Layout metadata={{ title, robots: { index: false } }}>
  <section class="min-h-[72vh] flex items-center p-6 md:p-10">
    <div class="max-w-3xl w-full mx-auto surface-panel border rounded-lg p-8 md:p-12 text-center">
      <p aria-hidden="true" class="font-heading text-7xl md:text-9xl text-primary font-medium">404</p>
      <h1 class="mt-3 text-3xl md:text-4xl font-heading font-medium">Page not found</h1>
      <p class="mt-4 mb-8 text-lg text-muted leading-relaxed">
        Sorry, we couldn't find this page. You can head back to the homepage.
      </p>
      <a rel="noopener noreferrer" href={getHomePermalink()} class="btn-primary">Back Home</a>
    </div>
  </section>
</Layout>
