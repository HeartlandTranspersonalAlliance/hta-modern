---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getPermalink } from '~/utils/permalinks';

import educationIcon from '~/assets/images/hta/visuals/education.svg';
import harmReductionIcon from '~/assets/images/hta/visuals/harm-reduction.svg';
import integrationIcon from '~/assets/images/hta/visuals/integration.svg';

const metadata = {
  title: 'Services',
};

const services = [
  {
    title: 'Community Education',
    description: 'Talks, gatherings, and public learning spaces for responsible exploration of consciousness.',
    icon: educationIcon,
    accent: 'accent-education',
  },
  {
    title: 'Integration Support',
    description: 'Peer-oriented circles and referral pathways for making meaning after intense experiences.',
    icon: integrationIcon,
    accent: 'accent-integration',
  },
  {
    title: 'Harm Reduction',
    description: 'Event support, overdose-prevention resources, and practical safety education for community settings.',
    icon: harmReductionIcon,
    accent: 'accent-harm-reduction',
  },
];
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Services"
    title="Community support pathways"
    subtitle="HTA coordinates education, integration, and harm-reduction services through aligned regional initiatives."
    callToAction={{ variant: 'primary', text: 'Explore Initiatives', href: getPermalink('/initiatives') }}
  />

  <section class="relative not-prose">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 md:py-16">
      <div class="grid gap-5 md:grid-cols-3">
        {
          services.map((service) => (
            <article class={`editorial-card program-card ${service.accent} p-6`}>
              <img src={service.icon.src} width="48" height="48" alt="" class="h-12 w-12 rounded-md" loading="lazy" />
              <h2 class="hta-strong mt-6 font-heading text-2xl font-semibold leading-tight">{service.title}</h2>
              <p class="hta-muted mt-4 text-base leading-7">{service.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CallToAction
    title="Start with the right access point"
    subtitle="Reach out for partnership, education, or board-related questions."
    actions={[
      {
        variant: 'primary',
        text: 'Contact HTA',
        href: getPermalink('/contact'),
      },
      {
        text: 'Apply for Board',
        href: getPermalink('/board-app'),
      },
    ]}
  />
</Layout>
