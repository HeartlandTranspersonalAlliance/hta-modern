---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Image from '~/components/common/Image.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { Icon } from 'astro-icon/components';
import { getPermalink } from '~/utils/permalinks';

import daleImage from '~/assets/images/hta/dale-bio2.jpg';
import christineImage from '~/assets/images/hta/christine-bio.jpg';
import elizabethImage from '~/assets/images/hta/liz-bio-3.png';
import ashleyImage from '~/assets/images/hta/ashley-bio.jpg';
import nateImage from '~/assets/images/hta/nate-bio.jpg';

const metadata = {
  title: 'Board of Directors',
  description:
    'Meet the Heartland Transpersonal Alliance board. We are actively seeking mission-aligned professionals in the Kansas City area.',
};

const members = [
  {
    name: 'Dale Morgan',
    role: 'President',
    image: daleImage,
    bio: 'Licensed EMT with harm-reduction experience across medical and festival teams since 2018, including RGX Medical, The Zendo Project, Lighthouse Medical, Jamcare Medical, NEST, and RaveSafe Kansas City.',
  },
  {
    name: 'Dr. Christine Ziemer',
    role: 'Executive Director',
    image: christineImage,
    bio: 'Professor of Psychology at Missouri Western State University with peer-counseling and integration leadership experience through The Zendo Project, Fireside Project, and regional psychedelic education networks.',
  },
  {
    name: 'Elizabeth Wells',
    role: 'Secretary',
    image: elizabethImage,
    bio: "Master's-prepared nurse with over a decade of clinical experience and active work in trauma-informed care, harm reduction, and psychedelic-assisted psychotherapy pathways.",
  },
  {
    name: 'Ashley Bennett',
    role: 'Director of Marketing',
    image: ashleyImage,
    bio: 'Leads HTA marketing, social campaigns, and community outreach with a focus on accessibility, responsible communication, and harm-reduction-aligned public education.',
  },
  {
    name: 'Nate Beam',
    role: 'Treasurer',
    image: nateImage,
    bio: 'Serves as Treasurer and on the Events Committee, bringing experience in community-centered budget coaching and event production to support sustainable organizational operations.',
  },
];
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Board of Directors"
    title="Kansas City leadership"
    subtitle="We are seeking motivated professionals in community activism, medicine, psychotherapy, social work, and education."
    callToAction={{ text: 'Apply Now', href: getPermalink('/board-app') }}
  />

  <section class="px-4 py-14 sm:px-6 md:py-16 mx-auto max-w-7xl not-prose">
    <div class="mb-8 grid items-end gap-6 lg:grid-cols-[0.8fr_1.2fr]">
      <div>
        <p class="section-kicker">Governance</p>
        <h2 class="mt-5 font-heading text-4xl font-semibold leading-[1.02] md:text-5xl">Mission stewards</h2>
      </div>
      <p class="max-w-3xl text-lg leading-relaxed text-muted">
        HTA's board supports the organizational systems behind integration, education, harm reduction, and community
        partnerships.
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 lg:gap-8">
      {
        members.map((member) => (
          <article class="hta-card field-card resource-card accent-institutional flex min-h-[25rem] flex-col rounded-lg p-5 transition duration-200 md:p-6">
            <div class="grid gap-4 sm:grid-cols-[7rem_1fr] sm:items-center">
              <Image
                src={member.image}
                alt={`Portrait of ${member.name}`}
                width={112}
                height={112}
                widths={[112, 224]}
                class="aspect-square h-28 w-28 rounded-full border border-[var(--hta-border)] object-cover"
              />
              <div>
                <h3 class="hta-strong font-heading text-xl font-semibold">{member.name}</h3>
                <p class="font-semibold text-[var(--hta-link)]">{member.role}</p>
              </div>
            </div>
            <p class="hta-muted readable-copy mt-5 line-clamp-3 text-base">{member.bio}</p>
            <details class="group mt-auto pt-4">
              <summary class="hta-focus-ring inline-flex cursor-pointer list-none items-center gap-2 rounded-md text-sm font-bold uppercase tracking-[0.04em] text-[var(--hta-link)] transition hover:text-[var(--hta-link-hover)]">
                Read more
                <Icon name="tabler:chevron-down" class="h-4 w-4 transition group-open:rotate-180" />
              </summary>
              <p class="hta-muted readable-copy mt-3 text-base leading-relaxed">{member.bio}</p>
            </details>
          </article>
        ))
      }
    </div>
  </section>

  <CallToAction
    title="Help build the next phase"
    subtitle="Board service supports governance, community programs, fundraising, partnerships, and responsible public communication. HTA is actively expanding capacity with people who can help steward the next stage."
    actions={[
      {
        variant: 'primary',
        text: 'Apply for Board',
        href: getPermalink('/board-app'),
      },
      {
        text: 'Contact HTA',
        href: getPermalink('/contact'),
      },
    ]}
  />
</Layout>
