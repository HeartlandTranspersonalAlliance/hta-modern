<style is:inline>
  :root {
    color-scheme: light;
    --aw-font-sans: 'Source Sans 3 Variable', 'Segoe UI', sans-serif;
    --aw-font-heading: 'Space Grotesk Variable', 'Avenir Next', sans-serif;
    --aw-font-serif: Georgia, serif;
    --hta-bg: #e7ebe9;
    --hta-surface: #f0f2f1;
