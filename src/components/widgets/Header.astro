---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';
import Button from '~/components/ui/Button.astro';

import { getHomePermalink } from '~/utils/permalinks';
import { trimSlash, getAsset } from '~/utils/permalinks';
import type { CallToAction } from '~/types';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface MenuLink extends Link {
  links?: Array<MenuLink>;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  actions?: Array<CallToAction>;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  position?: string;
}

const {
  id = 'header',
  links = [],
  actions = [],
  isSticky = false,
  isDark = false,
  isFullWidth = false,
  showToggleTheme = false,
  showRssFeed = false,
  position = 'center',
} = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;
const navPlacementClass =
  position === 'left' ? 'md:mr-auto md:ml-6' : position === 'right' ? 'md:ml-auto md:mr-6' : 'md:mx-6';
---

<header
  class:list={[
    { sticky: isSticky, relative: !isSticky, dark: isDark },
    'top-0 z-50 flex-none mx-auto w-full transition-[opacity] ease-out',
  ]}
  {...isSticky ? { 'data-aw-sticky-header': true } : {}}
  {...id ? { id } : {}}
>
  <div class="max-w-7xl mx-auto px-3 md:px-4 pt-3 md:pt-4">
    <div class:list={['hta-nav-shell relative border rounded-lg px-3 md:px-4 py-2.5', { 'max-w-7xl': !isFullWidth }]}>
      <div class="flex items-center justify-between gap-3">
        <a
          class="hta-logo-plate hta-focus-ring inline-flex shrink-0 items-center rounded-md px-2.5 py-1.5 md:px-3 md:py-2"
          href={getHomePermalink()}
        >
          <Logo />
        </a>

        <nav
          class:list={['hidden md:flex items-center gap-1.5 lg:gap-2', navPlacementClass]}
          aria-label="Main navigation"
        >
          {
            links.map(({ text, href, links }) => (
              <div class:list={[links?.length ? 'dropdown relative' : 'relative']}>
                {links?.length ? (
                  <>
                    <button
                      type="button"
                      class="hta-nav-link hta-focus-ring inline-flex items-center gap-1 whitespace-nowrap"
                      data-active={links.some(({ href: href2 }) => href2 === currentPath) ? 'true' : undefined}
                    >
                      {text}
                      <Icon name="tabler:chevron-down" class="h-4 w-4" />
                    </button>
                    <ul class="dropdown-menu hta-nav-shell hidden absolute top-[calc(100%+0.4rem)] left-0 rounded-lg border min-w-[210px] shadow-2xl p-1.5 z-20">
                      {links.map(({ text: text2, href: href2 }) => (
                        <li>
                          <a
                            class:list={[
                              'hta-nav-link hta-focus-ring block whitespace-nowrap rounded-md px-3.5 py-2 text-[0.95rem]',
                              { 'is-active': href2 === currentPath },
                            ]}
                            aria-current={href2 === currentPath ? 'page' : undefined}
                            href={href2}
                          >
                            {text2}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </>
                ) : (
                  <a
                    class:list={[
                      'hta-nav-link hta-focus-ring block whitespace-nowrap',
                      { 'is-active': href === currentPath },
                    ]}
                    aria-current={href === currentPath ? 'page' : undefined}
                    href={href}
                  >
                    {text}
                  </a>
                )}
              </div>
            ))
          }
        </nav>

        <div class="hidden md:flex items-center gap-1.5" data-aw-header-actions>
          {showToggleTheme && <ToggleTheme class="hta-icon-button hta-focus-ring" iconClass="h-5 w-5" />}
          {
            showRssFeed && (
              <a class="hta-icon-button hta-focus-ring" aria-label="RSS Feed" href={getAsset('/rss.xml')}>
                <Icon name="tabler:rss" class="h-5 w-5" />
              </a>
            )
          }
          {
            actions?.length ? (
              <span class="flex gap-2 pl-1">
                {actions.map((btnProps) => (
                  <Button {...btnProps} class="min-h-11 w-auto whitespace-nowrap px-5 py-2.5 text-sm font-bold" />
                ))}
              </span>
            ) : (
              ''
            )
          }
        </div>

        <div class="flex items-center md:hidden">
          <ToggleMenu class="hta-icon-button hta-focus-ring border-[var(--hta-icon-border)] bg-[var(--hta-icon-bg)]" />
        </div>
      </div>

      <div
        id="mobile-navigation"
        class="hidden md:hidden border-t border-[var(--hta-border)] mt-3 pt-3"
        data-aw-mobile-nav
      >
        <nav aria-label="Mobile navigation">
          <ul class="flex flex-col gap-1.5">
            {
              links.map(({ text, href, links }) => (
                <li>
                  {!links?.length ? (
                    <a
                      class:list={[
                        'hta-nav-link hta-focus-ring block min-h-11 rounded-md px-3.5 py-3 text-base',
                        { 'is-active': href === currentPath },
                      ]}
                      aria-current={href === currentPath ? 'page' : undefined}
                      href={href}
                    >
                      {text}
                    </a>
                  ) : (
                    <details class="group rounded-lg border border-[var(--hta-border)] bg-[var(--hta-surface)]">
                      <summary class="hta-nav-link hta-focus-ring flex min-h-11 cursor-pointer list-none items-center justify-between rounded-md px-3.5 py-3 text-base">
                        <span>{text}</span>
                        <Icon name="tabler:chevron-down" class="w-4 h-4 transition group-open:rotate-180" />
                      </summary>
                      <ul class="pb-2 px-2">
                        {links.map(({ text: text2, href: href2 }) => (
                          <li>
                            <a
                              class:list={[
                                'hta-nav-link hta-focus-ring block min-h-10 rounded-md px-3 py-2 text-base',
                                { 'is-active': href2 === currentPath },
                              ]}
                              aria-current={href2 === currentPath ? 'page' : undefined}
                              href={href2}
                            >
                              {text2}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </details>
                  )}
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="mt-3 pt-3 border-t border-[var(--hta-border)] flex items-center justify-between gap-3">
          <div class="flex items-center gap-1.5">
            {showToggleTheme && <ToggleTheme class="hta-icon-button hta-focus-ring" iconClass="h-5 w-5" />}
            {
              showRssFeed && (
                <a class="hta-icon-button hta-focus-ring" aria-label="RSS Feed" href={getAsset('/rss.xml')}>
                  <Icon name="tabler:rss" class="h-5 w-5" />
                </a>
              )
            }
          </div>
          {
            actions?.length ? (
              <span class="flex flex-wrap gap-2 justify-end">
                {actions.map((btnProps) => (
                  <Button {...btnProps} class="min-h-11 px-5 py-2.5 text-sm font-bold" />
                ))}
              </span>
            ) : (
              ''
            )
          }
        </div>
      </div>
    </div>
  </div>
</header>
