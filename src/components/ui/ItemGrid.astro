---
import type { ItemGrid as Props } from '~/types';
import { twMerge } from 'tailwind-merge';
import Button from './Button.astro';
import { Icon } from 'astro-icon/components';

const { items = [], columns, defaultIcon = '', classes = {} } = Astro.props;

const {
  container: containerClass = '',
  panel: panelClass = '',
  title: titleClass = '',
  description: descriptionClass = '',
  icon: defaultIconClass = 'text-[var(--hta-icon)]',
  action: actionClass = '',
} = classes;
---

{
  items && items.length > 0 && (
    <div
      class={twMerge(
        `grid mx-auto gap-4 md:gap-6 ${
          columns === 4
            ? 'lg:grid-cols-4 md:grid-cols-3 sm:grid-cols-2'
            : columns === 3
              ? 'lg:grid-cols-3 sm:grid-cols-2'
              : columns === 2
                ? 'sm:grid-cols-2 '
                : ''
        }`,
        containerClass
      )}
    >
      {items.map(({ title, description, icon, callToAction, classes: itemClasses = {} }) => (
        <article class="intersect-once motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
          <div
            class={twMerge(
              'hta-card field-card h-full rounded-lg p-5 md:p-6 flex flex-col max-w-none transition duration-200',
              panelClass,
              itemClasses?.panel
            )}
          >
            {(icon || defaultIcon) && (
              <div class="hta-icon-badge mb-5">
                <Icon name={icon || defaultIcon} class={twMerge('w-6 h-6', defaultIconClass, itemClasses?.icon)} />
              </div>
            )}

            {title && (
              <h3
                class={twMerge(
                  'hta-strong text-xl font-semibold font-heading leading-snug',
                  titleClass,
                  itemClasses?.title
                )}
              >
                {title}
              </h3>
            )}

            {description && (
              <p
                class={twMerge(
                  `${title ? 'mt-3' : ''} hta-muted text-[0.95rem] leading-7`,
                  descriptionClass,
                  itemClasses?.description
                )}
                set:html={description}
              />
            )}

            {callToAction && (
              <div class={twMerge(`mt-4`, actionClass, itemClasses?.actionClass)}>
                <Button variant="link" {...callToAction} />
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  )
}
