---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import { Icon } from 'astro-icon/components';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Contact',
};

const contacts = [
  {
    title: 'Email',
    description: 'info@psychedelickc.org',
    href: 'mailto:info@psychedelickc.org',
    icon: 'tabler:mail',
    accent: 'accent-research',
  },
  {
    title: 'Website',
    description: 'https://heartlandta.org',
    href: 'https://heartlandta.org',
    icon: 'tabler:world',
    accent: 'accent-community',
  },
  {
    title: 'Facebook',
    description: 'facebook.com/profile.php?id=61569597747801',
    href: 'https://www.facebook.com/profile.php?id=61569597747801',
    icon: 'tabler:brand-facebook',
    accent: 'accent-education',
  },
];
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Contact"
    title="Connect with HTA"
    subtitle="For partnerships, community programming, or board-related inquiries, reach out through the channels below."
    callToAction={{ text: 'Apply for Board', href: getPermalink('/board-app') }}
  />

  <section class="relative not-prose">
    <div class="mx-auto flex max-w-7xl flex-col gap-12 px-4 py-14 sm:px-6 md:py-16 lg:flex-row">
      <div class="lg:basis-1/2">
        <div class="mb-8 max-w-3xl">
          <p class="section-kicker text-center">Inquiry Paths</p>
          <h2 class="text-center mt-5 hta-section-title">Simple ways to start the conversation.</h2>
        </div>

        <div class="surface-panel p-3 md:p-4">
          {
            contacts.map((item) => (
              <a
                href={item.href}
                class={`resource-card ${item.accent} hta-focus-ring flex items-start gap-4 rounded-md p-4 transition duration-200 hover:bg-[var(--hta-icon-bg)] md:p-5`}
              >
                <span class="hta-icon-badge">
                  <Icon name={item.icon} />
                </span>
                <span class="min-w-0 flex-1">
                  <span class="hta-strong block font-heading text-xl font-semibold leading-tight">{item.title}</span>
                  <span class="hta-muted mt-1 block break-words text-base leading-7">{item.description}</span>
                </span>
              </a>
            ))
          }
        </div>
      </div>

      <section class="surface-panel p-6 md:p-8 lg:basis-1/2 lg:p-10 xl:max-w-xl" aria-labelledby="email-heading">
        <h2 id="email-heading" class="text-center hta-section-title">Email HTA</h2>
        <p class="mt-5">
          For partnerships, volunteering, board service, or general questions, send us an email. Include your name and
          what you would like to discuss.
        </p>
        <p class="mt-5">
          <a class="text-primary underline break-all" href="mailto:info@psychedelickc.org">info@psychedelickc.org</a>
        </p>
        <a class="btn-primary mt-7" href="mailto:info@psychedelickc.org">Open your email app</a>
        <p class="mt-4 text-sm">
          This opens your email app; it does not send a message automatically. You can also copy the address into your
          preferred email service.
        </p>
        <p class="mt-5 text-sm">
          Read our <a class="text-primary underline" href={getPermalink('/privacy')}>Privacy Policy</a> for how we use information
          you share.
        </p>
      </section>
    </div>
  </section>
</Layout>
