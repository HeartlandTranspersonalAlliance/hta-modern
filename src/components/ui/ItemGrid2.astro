---
import type { ItemGrid as Props } from '~/types';
import { Icon } from 'astro-icon/components';
import { twMerge } from 'tailwind-merge';
import Button from './Button.astro';

const { items = [], columns, defaultIcon = '', classes = {} } = Astro.props;

const {
  container: containerClass = '',
  panel: panelClass = '',
  title: titleClass = '',
  description: descriptionClass = '',
  icon: defaultIconClass = 'text-[var(--hta-icon)]',
} = classes;
---

{
  items && items.length > 0 && (
    <div
      class={twMerge(
        `grid gap-4 md:gap-6 ${
          columns === 4
            ? 'lg:grid-cols-4 md:grid-cols-3 sm:grid-cols-2'
            : columns === 3
              ? 'lg:grid-cols-3 sm:grid-cols-2'
              : columns === 2
                ? 'sm:grid-cols-2 '
                : ''
        }`,
        containerClass
      )}
    >
      {items.map(({ title, description, icon, callToAction, classes: itemClasses = {} }) => (
        <article
          class={twMerge(
            'hta-card field-card relative h-full rounded-lg p-5 md:p-6 flex flex-col transition duration-200 intersect-once intersect-quarter intersect-no-queue motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade',
            panelClass,
            itemClasses?.panel
          )}
        >
          {(icon || defaultIcon) && (
            <div class="hta-icon-badge mb-5">
              <Icon name={icon || defaultIcon} class={twMerge('w-6 h-6', defaultIconClass, itemClasses?.icon)} />
            </div>
          )}
          <h3
            class={twMerge(
              'hta-strong text-xl font-semibold font-heading leading-snug',
              titleClass,
              itemClasses?.title
            )}
          >
            {title}
          </h3>
          {description && (
            <p
              class={twMerge('hta-muted mt-3 text-[0.95rem] leading-7', descriptionClass, itemClasses?.description)}
              set:html={description}
            />
          )}
          {callToAction && (
            <div class="mt-4">
              <Button variant="link" {...callToAction} />
            </div>
          )}
        </article>
      ))}
    </div>
  )
}
