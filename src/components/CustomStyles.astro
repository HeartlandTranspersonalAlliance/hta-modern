<style is:inline>
  :root {
    color-scheme: light;

    --aw-font-sans: 'Avenir Next', 'Gill Sans', 'Trebuchet MS', sans-serif;
    --aw-font-serif: 'Iowan Old Style', 'Palatino Linotype', 'Book Antiqua', Georgia, serif;
    --aw-font-heading: 'Iowan Old Style', 'Palatino Linotype', Georgia, serif;

    --aw-color-primary: rgb(30 111 255);
    --aw-color-secondary: rgb(11 58 117);
    --aw-color-accent: rgb(244 162 97);

    --aw-color-text-heading: rgb(15 46 47);
    --aw-color-text-default: rgb(24 49 51);
    --aw-color-text-muted: rgb(70 91 94 / 88%);
    --aw-color-bg-page: rgb(247 251 252);
    --aw-color-bg-page-dark: rgb(15 46 47);

    --aw-surface: rgb(255 255 255 / 82%);
    --aw-surface-strong: rgb(255 255 255 / 96%);
    --aw-border: rgb(30 111 255 / 18%);
    --hta-blue: rgb(30 111 255);
    --hta-blue-dark: rgb(11 58 117);
    --hta-teal: rgb(15 46 47);
    --hta-teal-soft: rgb(22 75 77);
    --hta-gold: rgb(244 162 97);
    --hta-coral: rgb(255 122 89);
    --hta-text: rgb(230 241 242);
    --hta-muted: rgb(159 182 184);
    --bg: var(--aw-color-bg-page);
    --surface: var(--aw-surface);
    --surface-strong: var(--aw-surface-strong);
    --text: var(--aw-color-text-default);
    --primary: var(--aw-color-primary);

    ::selection {
      background-color: rgb(30 111 255);
      color: rgb(247 251 252);
    }
  }

  .dark {
    color-scheme: dark;

    --aw-font-sans: 'Avenir Next', 'Gill Sans', 'Trebuchet MS', sans-serif;
    --aw-font-serif: 'Iowan Old Style', 'Palatino Linotype', 'Book Antiqua', Georgia, serif;
    --aw-font-heading: 'Iowan Old Style', 'Palatino Linotype', Georgia, serif;

    --aw-color-primary: rgb(30 111 255);
    --aw-color-secondary: rgb(99 190 237);
    --aw-color-accent: rgb(255 122 89);

    --aw-color-text-heading: rgb(230 241 242);
    --aw-color-text-default: rgb(220 235 237);
    --aw-color-text-muted: rgb(159 182 184 / 92%);
    --aw-color-bg-page: rgb(15 46 47);

    --aw-surface: rgb(18 57 59 / 78%);
    --aw-surface-strong: rgb(22 75 77 / 92%);
    --aw-border: rgb(30 111 255 / 28%);
    --bg: var(--aw-color-bg-page);
    --surface: var(--aw-surface);
    --surface-strong: var(--aw-surface-strong);
    --text: var(--aw-color-text-default);
    --primary: var(--aw-color-primary);

    ::selection {
      background-color: rgb(30 111 255);
      color: rgb(230 241 242);
    }
  }
</style>
