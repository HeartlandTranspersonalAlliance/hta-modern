---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ProgramCard from '~/components/ui/ProgramCard.astro';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'Initiatives',
};

const initiatives = [
  {
    name: 'Kansas City Psychedelic Integration Circle',
    summary:
      'A confidential community focused on processing experiences outside the ordinary within a supportive, non-judgmental peer environment.',
    href: 'https://kc-psychedelic.com',
    cta: 'Visit KCPIC',
    icon: 'tabler:circles-relation',
    accent: 'accent-integration',
    label: 'Integration',
  },
  {
    name: 'Psychedelic Society of Kansas City',
    summary:
      'A community hub with in-person events exploring the intersection of psychedelics in art, culture, and medicine.',
    href: 'https://psychedelickc.org',
    cta: 'Visit PSKC',
    icon: 'tabler:school',
    accent: 'accent-education',
    label: 'Education',
  },
  {
    name: 'Safe Journey Sanctum',
    summary:
      'Compassionate, evidence-based peer support and overdose prevention at festivals and live events, including harm-reduction and Narcan training.',
    href: 'https://safejourneysanctum.org',
    cta: 'Visit SJS',
    icon: 'tabler:shield-heart',
    accent: 'accent-harm-reduction',
    label: 'Event support',
  },
];

const infrastructure = [
  {
    title: 'Education',
    description: 'Public events and literacy-building sessions give people a practical entry point.',
    icon: 'tabler:school',
    accent: 'accent-education',
  },
  {
    title: 'Integration',
    description: 'Peer circles help people process and make meaning after intense experiences.',
    icon: 'tabler:circles-relation',
    accent: 'accent-integration',
  },
  {
    title: 'Community',
    description: 'Local relationships keep referrals, partnerships, and stewardship grounded in KC.',
    icon: 'tabler:users-group',
    accent: 'accent-community',
  },
  {
    title: 'Field Care',
    description: 'Event support and overdose-prevention training make safety concrete in public settings.',
    icon: 'tabler:shield-heart',
    accent: 'accent-harm-reduction',
  },
];
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Initiatives"
    title="Our work across the region"
    subtitle="HTA initiatives create a connected support ecosystem across education, events, and integration pathways."
  />

  <section class="relative not-prose">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 md:py-16">
      <div class="mb-8 grid items-end gap-6 lg:grid-cols-[0.82fr_1.18fr]">
        <div>
          <p class="section-kicker">Program Pathways</p>
          <h2 class="mt-5 font-heading text-4xl font-semibold leading-[1.02] md:text-5xl">
            Distinct programs, shared standards.
          </h2>
        </div>
        <p class="max-w-3xl text-lg leading-relaxed text-muted">
          Each initiative serves a distinct need while staying connected through HTA's nonprofit mission, governance,
          and practical safety orientation.
        </p>
      </div>

      <div class="mb-6 flex flex-wrap items-center gap-2" aria-label="Program categories">
        <span class="mr-1 text-sm font-bold uppercase tracking-[0.065em] text-muted">Program categories</span>
        {initiatives.map((initiative) => <span class={`hta-badge ${initiative.accent}`}>{initiative.label}</span>)}
      </div>

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          initiatives.map((initiative, index) => (
            <ProgramCard
              accent={initiative.accent}
              icon={initiative.icon}
              number={String(index + 1).padStart(2, '0')}
              label={initiative.label}
              title={initiative.name}
              description={initiative.summary}
              href={initiative.href}
              cta={initiative.cta}
              class="min-h-[23rem]"
              descriptionClass="mb-0 min-h-[5rem] line-clamp-3"
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="resource-stripe relative not-prose">
    <div class="mx-auto grid max-w-7xl gap-8 px-4 py-14 sm:px-6 md:py-16 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="paper-panel p-6 md:p-8 lg:p-10">
        <p class="section-kicker">Shared Infrastructure</p>
        <h2 class="mt-5 font-heading text-4xl font-semibold leading-[1.02] md:text-5xl">
          Education, integration, and field support stay connected.
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-muted">
          HTA keeps these access points aligned so partners and community members can move from curiosity to support to
          safer action without starting over each time.
        </p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        {
          infrastructure.map((item, index) => (
            <article class={`editorial-card resource-card ${item.accent} flex h-full flex-col p-5 md:p-6`}>
              <div class="flex items-center justify-between gap-4">
                <span class="hta-icon-badge">
                  <Icon name={item.icon} />
                </span>
                <span class="font-heading text-2xl font-semibold text-[var(--hta-card-accent)]">
                  {String(index + 1).padStart(2, '0')}
                </span>
              </div>
              <h3 class="hta-strong mt-5 font-heading text-2xl font-semibold leading-tight">{item.title}</h3>
              <p class="hta-muted mt-3 text-base leading-relaxed">{item.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
