---
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';
import Image from '~/components/common/Image.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getPermalink } from '~/utils/permalinks';

import heroImage from '~/assets/images/hta/hero-image.jpg';

const metadata = {
  title: 'Heartland Transpersonal Alliance',
  ignoreTitleTemplate: true,
  description:
    'A nonprofit organization fostering community, education, harm reduction, and integration around the safe, responsible exploration of consciousness.',
};

const pathways = [
  {
    label: '01',
    icon: 'tabler:circles',
    title: 'Integration circles',
    description:
      'Confidential peer spaces for making meaning after intense or non-ordinary experiences, grounded in care and discretion.',
    href: 'https://kc-psychedelic.com',
    cta: 'KCPIC',
  },
  {
    label: '02',
    icon: 'tabler:calendar-event',
    title: 'Public education',
    description:
      'Talks, community gatherings, and literacy-building events that keep complicated topics practical and accessible.',
    href: 'https://psychedelickc.org',
    cta: 'PSKC',
  },
  {
    label: '03',
    icon: 'tabler:shield-heart',
    title: 'Event support',
    description:
      'Harm-reduction training, compassionate presence, and overdose-prevention resources for festivals and live events.',
    href: 'https://safejourneysanctum.org',
    cta: 'SJS',
  },
];

const principles = [
  'Community-led infrastructure',
  'Evidence-informed safety practices',
  'Integration after intensity',
];
---

<Layout metadata={metadata}>
  <section class="relative not-prose">
    <div
      class="mx-auto grid max-w-7xl items-center gap-8 px-4 pb-12 pt-8 sm:px-6 md:pb-16 md:pt-12 lg:grid-cols-[0.95fr_1.05fr] lg:gap-12"
    >
      <div class="max-w-2xl">
        <p class="section-kicker">Community Education Harm Reduction Integration</p>
        <h1 class="mt-5 font-heading text-5xl font-semibold leading-[0.98] text-heading md:text-6xl lg:text-7xl">
          Heartland Transpersonal Alliance
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-muted md:text-xl">
          HTA builds practical pathways for safe, responsible exploration of consciousness in Kansas City through
          nonprofit governance, community education, integration, and field-tested harm reduction.
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a class="btn-primary w-full sm:w-auto" href={getPermalink('/initiatives')}>Explore Initiatives</a>
          <a class="btn-secondary w-full sm:w-auto" href={getPermalink('/board')}>Meet the Board</a>
        </div>

        <div class="mt-8 grid max-w-xl gap-3 sm:grid-cols-3">
          <div class="border-t border-[var(--aw-border)] pt-3">
            <div class="font-heading text-3xl font-semibold text-primary">3</div>
            <div class="text-sm text-muted">active initiatives</div>
          </div>
          <div class="border-t border-[var(--aw-border)] pt-3">
            <div class="font-heading text-3xl font-semibold text-secondary">501(c)(3)</div>
            <div class="text-sm text-muted">Missouri nonprofit</div>
          </div>
          <div class="border-t border-[var(--aw-border)] pt-3">
            <div class="font-heading text-3xl font-semibold text-accent">KC</div>
            <div class="text-sm text-muted">regional focus</div>
          </div>
        </div>
      </div>

      <div class="relative">
        <div
          class="overflow-hidden rounded-[2rem] border border-[var(--aw-border)] shadow-[0_28px_82px_rgba(70,50,29,0.18)]"
        >
          <Image
            src={heroImage}
            alt="Abstract mandala artwork in warm earth tones and teal, representing HTA's integration work."
            width={1721}
            height={902}
            widths={[480, 768, 1200, 1721]}
            sizes="(max-width: 1023px) 100vw, 52vw"
            class="aspect-[16/10] h-full w-full object-cover"
            loading="eager"
          />
        </div>
        <div class="surface-card absolute -bottom-5 left-4 max-w-[18rem] rounded-2xl border p-4 md:left-8">
          <div class="flex items-center gap-3">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-primary/12 text-primary">
              <Icon name="tabler:heart-handshake" class="h-6 w-6" />
            </span>
            <p class="text-sm leading-relaxed text-muted">
              A shared home for integration, education, and compassionate care.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="relative not-prose">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16">
      <div class="grid items-end gap-8 lg:grid-cols-[0.9fr_1.1fr]">
        <div>
          <p class="section-kicker">What HTA Makes Possible</p>
          <h2 class="mt-4 max-w-2xl font-heading text-4xl font-semibold leading-[1.04] md:text-5xl">
            Transform intensity into support people can actually reach.
          </h2>
        </div>
        <p class="text-lg leading-relaxed text-muted md:text-xl">
          Inspired by compassionate peer-support models, HTA gives Kansas City a regional structure for preparation,
          presence, and integration. The work is practical: trusted programs, trained collaborators, and clear community
          access points.
        </p>
      </div>
    </div>
  </section>

  <section id="focus-areas" class="relative not-prose">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16">
      <div class="mb-8 max-w-3xl">
        <p class="section-kicker">Get Involved</p>
        <h2 class="mt-4 font-heading text-4xl font-semibold leading-[1.04] md:text-5xl">Three doors into the work</h2>
        <p class="mt-4 text-lg leading-relaxed text-muted">
          Each initiative serves a distinct need while staying connected through HTA's nonprofit mission and governance.
        </p>
      </div>

      <div class="grid gap-5 md:grid-cols-3">
        {
          pathways.map((item) => (
            <article class="field-card group flex min-h-[21rem] flex-col rounded-[1.6rem] p-6 transition duration-200 hover:-translate-y-1">
              <div class="flex items-start justify-between gap-4">
                <span class="font-heading text-4xl font-semibold text-primary">{item.label}</span>
                <span class="flex h-12 w-12 items-center justify-center rounded-full bg-secondary/12 text-secondary">
                  <Icon name={item.icon} class="h-6 w-6" />
                </span>
              </div>
              <h3 class="mt-8 font-heading text-2xl font-semibold">{item.title}</h3>
              <p class="mt-4 flex-1 leading-relaxed text-muted">{item.description}</p>
              <a
                href={item.href}
                target="_blank"
                rel="noreferrer"
                class="mt-6 inline-flex items-center gap-2 text-sm font-semibold uppercase text-primary transition group-hover:text-accent"
              >
                {item.cta}
                <Icon name="tabler:arrow-up-right" class="h-4 w-4" />
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="relative not-prose">
    <div class="mx-auto grid max-w-7xl gap-8 px-4 py-12 sm:px-6 md:py-16 lg:grid-cols-[0.92fr_1.08fr] lg:gap-12">
      <div class="overflow-hidden rounded-[2rem] border border-[var(--aw-border)]">
        <Image
          src={heroImage}
          alt="Warm abstract field artwork used as a visual anchor for HTA initiatives."
          width={1200}
          height={900}
          widths={[480, 768, 1200]}
          sizes="(max-width: 1023px) 100vw, 43vw"
          class="aspect-[4/5] h-full w-full object-cover"
        />
      </div>

      <div class="organic-panel rounded-[2rem] p-6 md:p-8 lg:p-10">
        <p class="section-kicker">Regional Ecosystem</p>
        <h2 class="mt-4 font-heading text-4xl font-semibold leading-[1.04] md:text-5xl">
          One alliance, multiple access points.
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-muted">
          HTA aligns public education, peer integration, and event-based care so community members and partners can find
          the right form of support at the right moment.
        </p>

        <ul class="mt-8 space-y-4">
          {
            principles.map((principle) => (
              <li class="flex gap-3 text-base leading-relaxed">
                <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-primary/12 text-primary">
                  <Icon name="tabler:check" class="h-4 w-4" />
                </span>
                <span>{principle}</span>
              </li>
            ))
          }
        </ul>

        <div class="mt-8">
          <a class="btn-primary" href={getPermalink('/initiatives')}>View all initiatives</a>
        </div>
      </div>
    </div>
  </section>

  <BlogLatestPosts
    title="News & Updates"
    information="Board updates, organizational announcements, and major initiative milestones."
    linkText="View all news"
    count={3}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Apply to the Board',
        href: getPermalink('/board-app'),
      },
      {
        text: 'Contact HTA',
        href: getPermalink('/contact'),
      },
    ]}
    title="Shape HTA"
    subtitle="We are actively building board capacity across community activism, medicine, psychotherapy, social work, and education."
  />
</Layout>
