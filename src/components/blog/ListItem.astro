---
import type { ImageMetadata } from 'astro';
import Image from '~/components/common/Image.astro';
import PostTags from '~/components/blog/Tags.astro';

import { APP_BLOG } from 'astrowind:config';
import type { Post } from '~/types';

import { getPermalink } from '~/utils/permalinks';
import { findImage } from '~/utils/images';
import { getFormattedDate } from '~/utils/utils';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const image = (await findImage(post.image)) as ImageMetadata | undefined;

const link = APP_BLOG?.post?.isEnabled ? getPermalink(post.permalink, 'post') : '';
---

<article
  class="surface-card flex h-full max-w-none flex-col overflow-hidden rounded-lg border intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
>
  {
    image &&
      (link ? (
        <a
          class="group relative block overflow-hidden border-b border-[var(--hta-border)]"
          href={link ?? 'javascript:void(0)'}
        >
          <div class="relative aspect-[16/9] overflow-hidden bg-[var(--aw-surface)]">
            {image && (
              <Image
                src={image}
                class="absolute inset-0 object-cover object-[center_35%] w-full h-full"
                widths={[400, 900]}
                width={900}
                sizes="(max-width: 900px) 400px, 900px"
                alt={post.title}
                aspectRatio="16:9"
                loading="lazy"
                decoding="async"
              />
            )}
          </div>
        </a>
      ) : (
        <div class="relative aspect-[16/9] overflow-hidden border-b border-[var(--hta-border)] bg-[var(--aw-surface)]">
          {image && (
            <Image
              src={image}
              class="absolute inset-0 object-cover object-[center_35%] w-full h-full"
              widths={[400, 900]}
              width={900}
              sizes="(max-width: 900px) 400px, 900px"
              alt={post.title}
              aspectRatio="16:9"
              loading="lazy"
              decoding="async"
            />
          )}
        </div>
      ))
  }
  <div class="flex flex-1 flex-col p-5 md:p-6">
    <header>
      <div class="mb-3 text-sm leading-6 text-muted">
        <time datetime={String(post.publishDate)} class="inline-block">{getFormattedDate(post.publishDate)}</time>
        {
          post.author && (
            <>
              {' '}
              &bull; <span>{post.author.replaceAll('-', ' ')}</span>
            </>
          )
        }
        {
          post.category && (
            <>
              {' '}
              &bull;{' '}
              <a class="hover:underline" href={getPermalink(post.category.slug, 'category')}>
                {post.category.title}
              </a>
            </>
          )
        }
      </div>
      <h2 class="mb-3 font-heading text-2xl font-semibold leading-tight">
        {
          link ? (
            <a class="inline-block hover:text-primary transition ease-in duration-200" href={link}>
              {post.title}
            </a>
          ) : (
            post.title
          )
        }
      </h2>
    </header>

    {post.excerpt && <p class="line-clamp-3 text-base leading-relaxed text-muted md:text-lg">{post.excerpt}</p>}
    {
      post.tags && Array.isArray(post.tags) ? (
        <footer class="mt-auto pt-5">
          <PostTags tags={post.tags} />
        </footer>
      ) : (
        <Fragment />
      )
    }
  </div>
</article>
