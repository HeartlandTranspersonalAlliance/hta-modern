---
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';
import Image from '~/components/common/Image.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getPermalink } from '~/utils/permalinks';

import heroImage from '~/assets/images/hta/hero-image.jpg';
import publicHealthGrid from '~/assets/images/hta/visuals/public-health-grid.svg';

const metadata = {
  title: 'Heartland Transpersonal Alliance',
  ignoreTitleTemplate: true,
  description:
    'A nonprofit organization fostering community, education, harm reduction, and integration around the safe, responsible exploration of consciousness.',
};

const pillars = [
  {
    label: 'Research-minded education',
    icon: 'tabler:flask-2',
    title: 'Evidence-informed public learning',
    description:
      'HTA creates approachable education around consciousness, psychedelic science, and responsible community care.',
    accent: 'accent-research',
  },
  {
    label: 'Community infrastructure',
    icon: 'tabler:users-group',
    title: 'Programs with local continuity',
    description:
      'Initiatives stay connected through nonprofit governance, shared standards, and Kansas City relationships.',
    accent: 'accent-community',
  },
  {
    label: 'Harm-reduction clarity',
    icon: 'tabler:lifebuoy',
    title: 'Direct safety pathways',
    description:
      'Training, peer support, and overdose-prevention resources make care practical where people actually gather.',
    accent: 'accent-harm-reduction',
  },
];

const pathways = [
  {
    label: '01',
    icon: 'tabler:circles-relation',
    title: 'Integration circles',
    description:
      'Confidential peer spaces for making meaning after intense or non-ordinary experiences, grounded in care and discretion.',
    href: 'https://kc-psychedelic.com',
    cta: 'KCPIC',
    accent: 'accent-integration',
  },
  {
    label: '02',
    icon: 'tabler:school',
    title: 'Public education',
    description:
      'Talks, community gatherings, and literacy-building events that keep complicated topics practical and accessible.',
    href: 'https://psychedelickc.org',
    cta: 'PSKC',
    accent: 'accent-education',
  },
  {
    label: '03',
    icon: 'tabler:shield-heart',
    title: 'Event support',
    description:
      'Harm-reduction training, compassionate presence, and overdose-prevention resources for festivals and live events.',
    href: 'https://safejourneysanctum.org',
    cta: 'SJS',
    accent: 'accent-harm-reduction',
  },
];

const principles = [
  'Community-led infrastructure',
  'Evidence-informed safety practices',
  'Integration after intensity',
];
---

<Layout metadata={metadata}>
  <section class="institutional-band relative not-prose border-y border-white/10">
    <div
      class="mx-auto grid max-w-7xl items-center gap-8 px-4 py-14 sm:px-6 md:py-16 lg:grid-cols-[0.94fr_1.06fr] lg:gap-12 lg:py-20"
    >
      <div class="max-w-3xl">
        <p class="section-kicker">Community Education Harm Reduction Integration</p>
        <h1 class="mt-6 font-heading text-5xl font-semibold leading-[0.98] text-white md:text-6xl lg:text-7xl">
          Heartland Transpersonal Alliance
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/80 md:text-xl">
          HTA builds practical pathways for safe, responsible exploration of consciousness in Kansas City through
          nonprofit governance, community education, integration, and field-tested harm reduction.
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a class="btn-primary w-full sm:w-auto" href={getPermalink('/initiatives')}>Explore Initiatives</a>
          <a
            class="btn-secondary w-full border-white/40 text-white hover:text-white sm:w-auto"
            href={getPermalink('/board')}
          >
            Meet the Board
          </a>
        </div>
      </div>

      <div class="grid gap-4 md:grid-cols-[0.82fr_0.18fr]">
        <div class="overflow-hidden rounded-lg border border-white/20 bg-white/5">
          <Image
            src={heroImage}
            alt="Abstract mandala artwork in warm earth tones and teal, representing HTA's integration work."
            width={1721}
            height={902}
            widths={[480, 768, 1200, 1721]}
            sizes="(max-width: 1023px) 100vw, 48vw"
            class="aspect-[16/10] h-full w-full object-cover opacity-90"
            loading="eager"
          />
        </div>
        <div class="grid grid-cols-3 gap-3 md:grid-cols-1">
          <div class="border-l-4 border-[var(--hta-logo-yellow)] bg-white/10 p-4">
            <div class="font-heading text-3xl font-semibold text-white">3</div>
            <div class="text-sm font-semibold uppercase tracking-[0.05em] text-white/70">active initiatives</div>
          </div>
          <div class="border-l-4 border-[var(--hta-logo-cyan)] bg-white/10 p-4">
            <div class="font-heading text-2xl font-semibold text-white">501(c)(3)</div>
            <div class="text-sm font-semibold uppercase tracking-[0.05em] text-white/70">Missouri nonprofit</div>
          </div>
          <div class="border-l-4 border-white/40 bg-white/10 p-4">
            <div class="font-heading text-3xl font-semibold text-white">KC</div>
            <div class="text-sm font-semibold uppercase tracking-[0.05em] text-white/70">regional focus</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="relative not-prose">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 md:py-16">
      <div class="grid items-start gap-8 lg:grid-cols-[0.84fr_1.16fr]">
        <div>
          <p class="section-kicker">What HTA Makes Possible</p>
          <h2 class="mt-5 max-w-2xl font-heading text-4xl font-semibold leading-[1.02] md:text-5xl">
            Transform intensity into support people can actually reach.
          </h2>
        </div>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            pillars.map((item) => (
              <article class={`editorial-card program-card ${item.accent} p-5 md:p-6`}>
                <span class="hta-icon-badge !h-12 !w-12" aria-hidden="true">
                  <Icon name={item.icon} />
                </span>
                <p class="mt-5 text-sm font-bold uppercase tracking-[0.06em] text-[var(--hta-card-accent)]">
                  {item.label}
                </p>
                <h3 class="hta-strong mt-3 font-heading text-2xl font-semibold leading-tight">{item.title}</h3>
                <p class="hta-muted mt-4 text-base leading-7">{item.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section id="focus-areas" class="resource-stripe relative not-prose">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 md:py-16">
      <div class="mb-8 grid items-end gap-6 lg:grid-cols-[0.8fr_1.2fr]">
        <div>
          <p class="section-kicker">Begin Your Journey</p>
          <h2 class="mt-5 font-heading text-4xl font-semibold leading-[1.02] md:text-5xl">Three doors into the work</h2>
        </div>
        <p class="max-w-3xl text-lg leading-relaxed text-muted">
          Inspired by compassionate peer-support models, HTA gives Kansas City trusted programs, trained collaborators,
          and clear access points.
        </p>
      </div>

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          pathways.map((item) => (
            <article class={`editorial-card program-card ${item.accent} flex min-h-[22rem] flex-col p-6`}>
              <div class="flex items-start justify-between gap-4">
                <span class="font-heading text-4xl font-semibold text-[var(--hta-card-accent)]">{item.label}</span>
                <span class="hta-icon-badge !h-12 !w-12" aria-hidden="true">
                  <Icon name={item.icon} />
                </span>
              </div>
              <h3 class="hta-strong mt-8 font-heading text-2xl font-semibold leading-snug">{item.title}</h3>
              <p class="hta-muted mt-4 flex-1 text-base leading-7">{item.description}</p>
              <a
                href={item.href}
                target="_blank"
                rel="noreferrer"
                class="hta-focus-ring mt-6 inline-flex min-h-10 items-center gap-2 rounded-md text-sm font-bold uppercase tracking-[0.04em] text-[var(--hta-link)] transition duration-200 hover:text-[var(--hta-link-hover)]"
              >
                {item.cta}
                <Icon name="tabler:arrow-up-right" class="h-4 w-4" />
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="relative not-prose">
    <div class="mx-auto grid max-w-7xl gap-8 px-4 py-14 sm:px-6 md:py-16 lg:grid-cols-[0.92fr_1.08fr] lg:gap-12">
      <div class="overflow-hidden rounded-lg border border-[var(--hta-border)] bg-[var(--hta-paper)]">
        <img
          src={publicHealthGrid.src}
          width="720"
          height="420"
          alt=""
          class="h-full min-h-[22rem] w-full object-cover"
          loading="lazy"
        />
      </div>

      <div class="paper-panel p-6 md:p-8 lg:p-10">
        <p class="section-kicker">Regional Ecosystem</p>
        <h2 class="mt-5 font-heading text-4xl font-semibold leading-[1.02] md:text-5xl">
          One alliance, multiple access points.
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-muted">
          HTA aligns public education, peer integration, and event-based care so community members and partners can find
          the right form of support at the right moment.
        </p>

        <ul class="mt-8 grid gap-4">
          {
            principles.map((principle) => (
              <li class="resource-card accent-institutional flex gap-3 bg-[var(--hta-surface)] p-4 text-base leading-relaxed">
                <span class="hta-icon-badge mt-0.5">
                  <Icon name="tabler:check" />
                </span>
                <span class="hta-strong font-semibold">{principle}</span>
              </li>
            ))
          }
        </ul>

        <div class="mt-8">
          <a class="btn-primary" href={getPermalink('/initiatives')}>View all initiatives</a>
        </div>
      </div>
    </div>
  </section>

  <BlogLatestPosts
    title="News & Updates"
    information="Board updates, organizational announcements, and major initiative milestones."
    linkText="View all news"
    count={3}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Apply to the Board',
        href: getPermalink('/board-app'),
      },
      {
        text: 'Contact HTA',
        href: getPermalink('/contact'),
      },
    ]}
    title="Shape HTA"
    subtitle="We are actively building board capacity across community activism, medicine, psychotherapy, social work, and education."
  />
</Layout>
