---
import { Icon } from 'astro-icon/components';
import { getHomePermalink } from '~/utils/permalinks';
import Logo from '~/components/Logo.astro';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  secondaryLinks: Array<Link>;
  socialLinks: Array<Link>;
  footNote?: string;
  theme?: string;
}

const { socialLinks = [], secondaryLinks = [], links = [], footNote = '', theme = 'light' } = Astro.props;
---

<footer class:list={[{ dark: theme === 'dark' }, 'relative mt-16 md:mt-20 pb-8 md:pb-12 not-prose']}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="footer-shell px-5 sm:px-7 py-7 md:py-8">
      <div class="grid grid-cols-2 gap-x-6 gap-y-8 md:grid-cols-6 lg:grid-cols-12">
        <div class="col-span-2 md:col-span-6 lg:col-span-5">
          <a class="hta-logo-plate hta-focus-ring inline-flex rounded-md py-2" href={getHomePermalink()}>
            <Logo />
          </a>
          <p class="mt-5 text-sm leading-7 text-[var(--hta-footer-muted)]">
            Heartland Transpersonal Alliance is building safe, practical pathways for community, education, and
            integration.
          </p>
          {
            secondaryLinks.length > 0 && (
              <div class="mt-4 flex flex-wrap gap-1 text-sm text-[var(--hta-footer-muted)]">
                {secondaryLinks.map(({ text, href }, index) => (
                  <>
                    {index !== 0 ? ' · ' : ''}
                    <a
                      class="hta-focus-ring rounded-sm transition hover:text-[var(--hta-link-hover)] hover:underline"
                      href={href}
                      set:html={text}
                    />
                  </>
                ))}
              </div>
            )
          }
        </div>

        {
          links.map(({ title, links: groupLinks }) => (
            <div class="col-span-1 md:col-span-2 lg:col-span-2">
              <div class="mb-3 font-heading text-[0.78rem] font-bold uppercase tracking-[0.065em] text-[var(--hta-footer-text)]">
                {title}
              </div>
              {groupLinks && groupLinks.length > 0 && (
                <ul class="text-sm space-y-2.5">
                  {groupLinks.map(({ text, href, ariaLabel }) => (
                    <li>
                      <a
                        class="hta-focus-ring rounded-sm text-[var(--hta-footer-muted)] transition hover:text-[var(--hta-link-hover)]"
                        href={href}
                        aria-label={ariaLabel}
                      >
                        <Fragment set:html={text} />
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))
        }

        <div class="col-span-2 md:col-span-6 lg:col-span-1 lg:flex lg:justify-end">
          {
            socialLinks?.length ? (
              <ul class="flex gap-2.5 lg:flex-col lg:items-end">
                {socialLinks.map(({ ariaLabel, href, text, icon }) => (
                  <li>
                    <a
                      class="hta-focus-ring inline-flex h-11 w-11 items-center justify-center rounded-md border border-[var(--hta-footer-border)] text-sm text-[var(--hta-footer-muted)] transition-colors duration-200 hover:border-[var(--hta-icon-border)] hover:bg-[var(--hta-icon-bg)] hover:text-[var(--hta-link-hover)]"
                      aria-label={ariaLabel}
                      href={href}
                    >
                      {icon && <Icon name={icon} class="w-5 h-5" />}
                      {!icon && <Fragment set:html={text} />}
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              ''
            )
          }
        </div>
      </div>

      <div
        class="mt-8 border-t border-[var(--hta-footer-border)] pt-6 text-[0.82rem] leading-6 text-[var(--hta-footer-muted)]"
      >
        <Fragment set:html={footNote} />
      </div>
    </div>
  </div>
</footer>
