---
import Item from '~/components/blog/GridItem.astro';
import type { Post } from '~/types';

export interface Props {
  posts: Array<Post>;
}

const { posts } = Astro.props;
const gridClass =
  posts.length <= 1
    ? 'grid gap-4 md:gap-5 max-w-xl'
    : posts.length === 2
      ? 'grid gap-4 md:gap-5 md:grid-cols-2'
      : posts.length === 3
        ? 'grid gap-4 md:gap-5 md:grid-cols-2 lg:grid-cols-3'
        : 'grid gap-4 md:gap-5 md:grid-cols-2 lg:grid-cols-4';
---

<div class={gridClass}>
  {posts.map((post) => <Item post={post} />)}
</div>
