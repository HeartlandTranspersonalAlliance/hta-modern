---
import { Icon } from 'astro-icon/components';

import { UI } from 'astrowind:config';

export interface Props {
  label?: string;
  class?: string;
  iconClass?: string;
  iconName?: string;
}

const {
  label = 'Toggle between Dark and Light mode',
  class: className = 'hta-icon-button hta-focus-ring',
  iconClass = 'h-5 w-5',
  iconName = 'tabler:moon',
} = Astro.props;
---

{
  !(UI.theme && UI.theme.endsWith(':only')) && (
    <button
      type="button"
      class={className}
      aria-label={label}
      aria-pressed="false"
      title="Toggle dark mode"
      data-aw-toggle-color-scheme
    >
      <span class="sr-only">{label}</span>
      <Icon name={iconName} class:list={[iconClass, 'dark:hidden']} aria-hidden="true" />
      <Icon name="tabler:sun" class:list={[iconClass, 'hidden dark:block']} aria-hidden="true" />
    </button>
  )
}
