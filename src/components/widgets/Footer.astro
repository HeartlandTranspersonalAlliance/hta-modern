---
import { Icon } from 'astro-icon/components';
import { SITE } from 'astrowind:config';
import { getHomePermalink } from '~/utils/permalinks';
import footerWordmark from '~/assets/images/hta_header_footer.png';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  secondaryLinks: Array<Link>;
  socialLinks: Array<Link>;
  footNote?: string;
  theme?: string;
}

const { socialLinks = [], secondaryLinks = [], links = [], footNote = '', theme = 'light' } = Astro.props;
---

<footer class:list={[{ dark: theme === 'dark' }, 'relative mt-10 md:mt-14 pb-8 md:pb-12 not-prose']}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="footer-shell rounded-lg px-5 sm:px-7 py-7 md:py-8">
      <div class="grid grid-cols-12 gap-8">
        <div class="col-span-12 lg:col-span-4">
          <a class="hta-logo-plate hta-focus-ring inline-flex rounded-md px-3 py-2" href={getHomePermalink()}>
            <img
              src={footerWordmark.src}
              width={footerWordmark.width}
              height={footerWordmark.height}
              alt={SITE?.name ?? 'Heartland Transpersonal Alliance'}
              class="h-10 w-auto max-w-[80vw] object-contain md:h-12"
              loading="lazy"
              decoding="async"
            />
          </a>
          <p class="mt-5 text-sm text-white/80 leading-7">
            Heartland Transpersonal Alliance is building safe, practical pathways for community, education, and
            integration.
          </p>
          {
            secondaryLinks.length > 0 && (
              <div class="mt-4 flex flex-wrap gap-1 text-sm text-white/80">
                {secondaryLinks.map(({ text, href }, index) => (
                  <>
                    {index !== 0 ? ' · ' : ''}
                    <a
                      class="hta-focus-ring rounded-sm hover:text-[var(--hta-logo-cyan)] hover:underline transition"
                      href={href}
                      set:html={text}
                    />
                  </>
                ))}
              </div>
            )
          }
        </div>

        {
          links.map(({ title, links: groupLinks }) => (
            <div class="col-span-6 md:col-span-4 lg:col-span-2">
              <div class="mb-3 font-heading text-[0.78rem] font-bold uppercase tracking-[0.07em] text-white">
                {title}
              </div>
              {groupLinks && groupLinks.length > 0 && (
                <ul class="text-sm space-y-2.5">
                  {groupLinks.map(({ text, href, ariaLabel }) => (
                    <li>
                      <a
                        class="hta-focus-ring rounded-sm text-white/80 hover:text-[var(--hta-logo-cyan)] transition"
                        href={href}
                        aria-label={ariaLabel}
                      >
                        <Fragment set:html={text} />
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))
        }

        <div class="col-span-12 lg:col-span-2 lg:flex lg:justify-end">
          {
            socialLinks?.length ? (
              <ul class="flex gap-2.5 lg:flex-col lg:items-end">
                {socialLinks.map(({ ariaLabel, href, text, icon }) => (
                  <li>
                    <a
                      class="hta-focus-ring inline-flex h-11 w-11 items-center justify-center rounded-md border border-white/10 text-sm text-white/80 transition-colors duration-200 hover:border-[var(--hta-icon-border)] hover:bg-[var(--hta-icon-bg)] hover:text-[var(--hta-logo-cyan)]"
                      aria-label={ariaLabel}
                      href={href}
                    >
                      {icon && <Icon name={icon} class="w-5 h-5" />}
                      {!icon && <Fragment set:html={text} />}
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              ''
            )
          }
        </div>
      </div>

      <div class="mt-8 border-t border-white/10 pt-6 text-[0.82rem] leading-6 text-white/75">
        <Fragment set:html={footNote} />
      </div>
    </div>
  </div>
</footer>
