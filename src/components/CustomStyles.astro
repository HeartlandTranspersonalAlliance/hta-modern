<style is:inline>
  :root {
    color-scheme: light;

    --aw-font-sans: 'Avenir Next', 'Gill Sans', 'Trebuchet MS', sans-serif;
    --aw-font-serif: 'Iowan Old Style', 'Palatino Linotype', 'Book Antiqua', Georgia, serif;
    --aw-font-heading: 'Iowan Old Style', 'Palatino Linotype', Georgia, serif;

    --aw-color-primary: rgb(190 82 43);
    --aw-color-secondary: rgb(20 111 113);
    --aw-color-accent: rgb(219 156 68);

    --aw-color-text-heading: rgb(31 29 23);
    --aw-color-text-default: rgb(48 48 39);
    --aw-color-text-muted: rgb(75 78 68 / 88%);
    --aw-color-bg-page: rgb(246 239 221);
    --aw-color-bg-page-dark: rgb(18 31 33);

    --aw-surface: rgb(255 250 239 / 78%);
    --aw-surface-strong: rgb(255 251 242 / 94%);
    --aw-border: rgb(143 117 83 / 30%);
    --hta-moss: rgb(97 126 89);
    --hta-clay: rgb(190 82 43);
    --hta-gold: rgb(219 156 68);
    --hta-lagoon: rgb(20 111 113);

    ::selection {
      background-color: rgb(225 170 86);
      color: rgb(31 21 14);
    }
  }

  .dark {
    color-scheme: dark;

    --aw-font-sans: 'Avenir Next', 'Gill Sans', 'Trebuchet MS', sans-serif;
    --aw-font-serif: 'Iowan Old Style', 'Palatino Linotype', 'Book Antiqua', Georgia, serif;
    --aw-font-heading: 'Iowan Old Style', 'Palatino Linotype', Georgia, serif;

    --aw-color-primary: rgb(238 131 80);
    --aw-color-secondary: rgb(110 211 195);
    --aw-color-accent: rgb(239 185 102);

    --aw-color-text-heading: rgb(246 239 222);
    --aw-color-text-default: rgb(227 229 214);
    --aw-color-text-muted: rgb(175 190 179 / 90%);
    --aw-color-bg-page: rgb(18 31 33);

    --aw-surface: rgb(21 47 47 / 74%);
    --aw-surface-strong: rgb(24 55 54 / 90%);
    --aw-border: rgb(150 190 170 / 25%);

    ::selection {
      background-color: rgb(238 131 80);
      color: rgb(18 31 33);
    }
  }
</style>
