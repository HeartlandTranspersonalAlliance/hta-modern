---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import { Icon } from 'astro-icon/components';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Contact',
};

const contacts = [
  {
    title: 'Email',
    description: 'info@psychedelickc.org',
    href: 'mailto:info@psychedelickc.org',
    icon: 'tabler:mail',
    accent: 'accent-research',
  },
  {
    title: 'Website',
    description: 'https://heartlandta.org',
    href: 'https://heartlandta.org',
    icon: 'tabler:world',
    accent: 'accent-community',
  },
  {
    title: 'Facebook',
    description: 'facebook.com/profile.php?id=61569597747801',
    href: 'https://www.facebook.com/profile.php?id=61569597747801',
    icon: 'tabler:brand-facebook',
    accent: 'accent-education',
  },
];
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Contact"
    title="Connect with HTA"
    subtitle="For partnerships, community programming, or board-related inquiries, reach out through the channels below."
    callToAction={{ text: 'Apply for Board', href: getPermalink('/board-app') }}
  />

  <section class="relative not-prose">
    <div class="mx-auto grid max-w-7xl gap-8 px-4 py-14 sm:px-6 md:py-16 lg:grid-cols-[0.86fr_1.14fr]">
      <div>
        <div class="mb-8 max-w-3xl">
          <p class="section-kicker">Inquiry Paths</p>
          <h2 class="mt-5 font-heading text-4xl font-semibold leading-[1.02] md:text-5xl">
            Simple ways to start the conversation.
          </h2>
        </div>

        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1">
          {
            contacts.map((item) => (
              <a
                href={item.href}
                class={`editorial-card resource-card ${item.accent} hta-focus-ring block p-5 transition duration-200 hover:-translate-y-0.5 md:p-6`}
              >
                <span class="hta-icon-badge">
                  <Icon name={item.icon} />
                </span>
                <h3 class="hta-strong mt-5 font-heading text-2xl font-semibold leading-tight">{item.title}</h3>
                <p class="hta-muted mt-3 break-words text-base leading-7">{item.description}</p>
              </a>
            ))
          }
        </div>
      </div>

      <form
        class="paper-panel p-6 md:p-8 lg:p-10"
        action="mailto:info@psychedelickc.org"
        method="post"
        enctype="text/plain"
      >
        <h2 class="hta-strong font-heading text-3xl font-semibold leading-tight md:text-4xl">Send a message</h2>

        <div class="mt-7 grid gap-5 sm:grid-cols-2">
          <div>
            <label for="contact-name" class="mb-2 block text-sm font-bold uppercase tracking-[0.065em]"> Name </label>
            <input
              id="contact-name"
              name="name"
              type="text"
              autocomplete="name"
              required
              class="form-field block text-base"
            />
          </div>

          <div>
            <label for="contact-email" class="mb-2 block text-sm font-bold uppercase tracking-[0.065em]"> Email </label>
            <input
              id="contact-email"
              name="email"
              type="email"
              autocomplete="email"
              required
              class="form-field block text-base"
            />
          </div>
        </div>

        <div class="mt-5">
          <label for="contact-topic" class="mb-2 block text-sm font-bold uppercase tracking-[0.065em]">Topic</label>
          <select id="contact-topic" name="topic" required class="form-field block text-base">
            <option value="">Select a topic</option>
            <option>Partnerships</option>
            <option>Community programming</option>
            <option>Board service</option>
            <option>General inquiry</option>
          </select>
        </div>

        <div class="mt-5">
          <label for="contact-message" class="mb-2 block text-sm font-bold uppercase tracking-[0.065em]">
            Message
          </label>
          <textarea id="contact-message" name="message" rows="7" required class="form-field block text-base"></textarea>
        </div>

        <label class="mt-5 flex items-start gap-3 text-sm leading-6 text-muted" for="contact-consent">
          <input id="contact-consent" name="consent" type="checkbox" required class="form-checkbox mt-1 shrink-0" />
          <span>I agree to be contacted by Heartland Transpersonal Alliance about this inquiry.</span>
        </label>

        <div class="mt-8">
          <button type="submit" class="btn-primary w-full sm:w-auto">Send Message</button>
        </div>
      </form>
    </div>
  </section>
</Layout>
