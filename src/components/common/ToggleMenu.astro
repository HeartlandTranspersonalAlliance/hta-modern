---
import { twMerge } from 'tailwind-merge';

export interface Props {
  label?: string;
  class?: string;
}

const {
  label = 'Toggle Menu',
  class: className = 'hta-icon-button hta-focus-ring border-[var(--hta-icon-border)] bg-[var(--hta-icon-bg)]',
} = Astro.props;

const baseClass = 'group flex h-11 w-11 flex-col items-center justify-center rounded-md text-[var(--hta-icon)]';
---

<button
  type="button"
  class={twMerge(baseClass, className)}
  aria-label={label}
  aria-controls="mobile-navigation"
  aria-expanded="false"
  data-aw-toggle-menu
>
  <span class="sr-only">{label}</span>
  <slot>
    <span
      aria-hidden="true"
      class="h-0.5 w-5 my-1 rounded-full bg-current transition ease transform duration-200 opacity-85 group-[.expanded]:rotate-45 group-[.expanded]:translate-y-2.5"
    ></span>
    <span
      aria-hidden="true"
      class="h-0.5 w-5 my-1 rounded-full bg-current transition ease transform duration-200 opacity-85 group-[.expanded]:opacity-0"
    ></span>
    <span
      aria-hidden="true"
      class="h-0.5 w-5 my-1 rounded-full bg-current transition ease transform duration-200 opacity-85 group-[.expanded]:-rotate-45 group-[.expanded]:-translate-y-2.5"
    ></span>
  </slot>
</button>
