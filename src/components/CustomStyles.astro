<style is:inline>
  :root {
    color-scheme: light;

    --aw-font-sans: 'Avenir Next', 'Gill Sans', 'Trebuchet MS', sans-serif;
    --aw-font-serif: 'Iowan Old Style', 'Palatino Linotype', 'Book Antiqua', Georgia, serif;
    --aw-font-heading: 'Iowan Old Style', 'Palatino Linotype', Georgia, serif;

    --hta-logo-cyan: #18c7ee;
    --hta-logo-cyan-rgb: 24 199 238;
    --hta-logo-blue: #0b7dff;
    --hta-logo-blue-rgb: 11 125 255;
    --hta-logo-navy: #071f3f;
    --hta-logo-navy-rgb: 7 31 63;
    --hta-logo-yellow: #f4c84a;
    --hta-logo-yellow-rgb: 244 200 74;

    --hta-ink: #071624;
    --hta-ink-rgb: 7 22 36;
    --hta-institutional: #09243a;
    --hta-accent-primary: #087086;
    --hta-accent-primary-rgb: 8 112 134;
    --hta-accent-secondary: #26745f;
    --hta-accent-secondary-rgb: 38 116 95;
    --hta-accent-warm: #8a6500;
    --hta-accent-warm-rgb: 138 101 0;
    --hta-research: var(--hta-accent-primary);
    --hta-education: var(--hta-accent-primary);
    --hta-harm-reduction: var(--hta-accent-warm);
    --hta-community: var(--hta-accent-secondary);
    --hta-integration: var(--hta-accent-secondary);

    --hta-bg: #f4f7f5;
    --hta-bg-soft: #e8f0ee;
    --hta-paper: #fffdf6;
    --hta-surface: #ffffff;
    --hta-surface-raised: #fffdf6;
    --hta-surface-glass: #ffffff;

    --hta-text: #20333a;
    --hta-text-strong: #071624;
    --hta-text-muted: #4c6166;

    --hta-border: rgba(7, 22, 36, 0.16);
    --hta-border-strong: rgba(7, 22, 36, 0.32);

    --hta-link: #075f72;
    --hta-link-hover: #063f4e;
    --hta-nav-active: #071624;
    --hta-nav-active-bg: rgba(var(--hta-accent-primary-rgb) / 0.11);

    --hta-icon: var(--hta-research);
    --hta-icon-strong: var(--hta-institutional);
    --hta-icon-bg: rgba(var(--hta-accent-primary-rgb) / 0.1);
    --hta-icon-border: rgba(var(--hta-accent-primary-rgb) / 0.28);

    --hta-focus: var(--hta-accent-primary);
    --hta-shadow: rgba(7, 22, 36, 0.12);

    --hta-hero-bg:
      linear-gradient(90deg, rgba(var(--hta-logo-cyan-rgb) / 0.16), transparent 34%),
      linear-gradient(135deg, var(--hta-ink), var(--hta-institutional) 62%, #0f3a45);
    --hta-cta-bg:
      linear-gradient(90deg, rgba(var(--hta-logo-yellow-rgb) / 0.18), transparent 36%),
      linear-gradient(135deg, var(--hta-paper), #edf5f2 64%, #e3f1ef);
    --hta-cta-text: var(--hta-text-strong);
    --hta-cta-muted: var(--hta-text-muted);
    --hta-cta-border: var(--hta-border);
    --hta-footer-bg:
      linear-gradient(90deg, rgba(var(--hta-accent-primary-rgb) / 0.08), transparent 34%),
      linear-gradient(135deg, var(--hta-paper), #edf4f1 68%, #e1f0ee);
    --hta-footer-text: var(--hta-text-strong);
    --hta-footer-muted: #516368;
    --hta-footer-border: var(--hta-border);

    --aw-color-primary: var(--hta-link);
    --aw-color-secondary: var(--hta-institutional);
    --aw-color-accent: var(--hta-logo-yellow);

    --aw-color-text-heading: var(--hta-text-strong);
    --aw-color-text-default: var(--hta-text);
    --aw-color-text-muted: var(--hta-text-muted);
    --aw-color-bg-page: var(--hta-bg);
    --aw-color-bg-page-dark: #071624;

    --aw-surface: var(--hta-surface);
    --aw-surface-strong: var(--hta-paper);
    --aw-border: var(--hta-border);
    --hta-blue: var(--hta-logo-blue);
    --hta-blue-dark: var(--hta-logo-navy);
    --hta-teal: var(--hta-community);
    --hta-teal-soft: #e4f4ef;
    --hta-gold: var(--hta-logo-yellow);
    --hta-coral: #c64e37;
    --hta-muted: var(--hta-text-muted);
    --bg: var(--hta-bg);
    --surface: var(--hta-surface);
    --surface-strong: var(--hta-surface-raised);
    --text: var(--hta-text);
    --primary: var(--hta-link);

    ::selection {
      background-color: var(--hta-logo-blue);
      color: #ffffff;
    }
  }

  .dark {
    color-scheme: dark;

    --hta-accent-primary: #64d8f3;
    --hta-accent-primary-rgb: 100 216 243;
    --hta-accent-secondary: #82d8bd;
    --hta-accent-secondary-rgb: 130 216 189;
    --hta-accent-warm: #f6d36a;
    --hta-accent-warm-rgb: 246 211 106;
    --hta-research: var(--hta-accent-primary);
    --hta-education: var(--hta-accent-primary);
    --hta-harm-reduction: var(--hta-accent-warm);
    --hta-community: var(--hta-accent-secondary);
    --hta-integration: var(--hta-accent-secondary);

    --hta-bg: #071624;
    --hta-bg-soft: #0d2334;
    --hta-paper: #10283a;
    --hta-surface: #0d2334;
    --hta-surface-raised: #123149;
    --hta-surface-glass: #0d2334;

    --hta-text: #e8f2f1;
    --hta-text-strong: #ffffff;
    --hta-text-muted: #c3d4d2;

    --hta-border: rgba(255, 255, 255, 0.16);
    --hta-border-strong: rgba(255, 255, 255, 0.34);

    --hta-link: #64d8f3;
    --hta-link-hover: #ffffff;
    --hta-nav-active: #ffffff;
    --hta-nav-active-bg: rgba(var(--hta-accent-primary-rgb) / 0.12);

    --hta-icon: #64d8f3;
    --hta-icon-strong: #ffffff;
    --hta-icon-bg: rgba(var(--hta-accent-primary-rgb) / 0.12);
    --hta-icon-border: rgba(var(--hta-accent-primary-rgb) / 0.3);

    --hta-focus: #64d8f3;
    --hta-shadow: rgba(0, 0, 0, 0.34);

    --hta-hero-bg:
      linear-gradient(90deg, rgba(var(--hta-logo-cyan-rgb) / 0.2), transparent 34%),
      linear-gradient(135deg, #050d16, var(--hta-institutional) 64%, #0f3a45);
    --hta-cta-bg:
      linear-gradient(90deg, rgba(var(--hta-logo-yellow-rgb) / 0.18), transparent 36%),
      linear-gradient(135deg, #071624, #0a2b42 64%, #0b5963);
    --hta-cta-text: #ffffff;
    --hta-cta-muted: rgba(255, 255, 255, 0.78);
    --hta-cta-border: rgba(255, 255, 255, 0.14);
    --hta-footer-bg:
      linear-gradient(90deg, rgba(var(--hta-logo-cyan-rgb) / 0.16), transparent 32%),
      linear-gradient(135deg, #050d16, var(--hta-institutional) 66%, #0c3944);
    --hta-footer-text: #ffffff;
    --hta-footer-muted: rgba(255, 255, 255, 0.78);
    --hta-footer-border: rgba(255, 255, 255, 0.12);

    --aw-color-primary: var(--hta-link);
    --aw-color-secondary: var(--hta-logo-cyan);
    --aw-color-accent: var(--hta-logo-yellow);

    --aw-color-text-heading: var(--hta-text-strong);
    --aw-color-text-default: var(--hta-text);
    --aw-color-text-muted: var(--hta-text-muted);
    --aw-color-bg-page: var(--hta-bg);

    --aw-surface: var(--hta-surface);
    --aw-surface-strong: var(--hta-surface-raised);
    --aw-border: var(--hta-border);
    --hta-muted: var(--hta-text-muted);
    --bg: var(--hta-bg);
    --surface: var(--hta-surface);
    --surface-strong: var(--hta-surface-raised);
    --text: var(--hta-text);
    --primary: var(--hta-link);

    ::selection {
      background-color: var(--hta-logo-cyan);
      color: #071624;
    }
  }
</style>
