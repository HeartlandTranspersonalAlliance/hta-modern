---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Board Application',
};
---

<Layout metadata={metadata}>
  <section class="board-app-hero relative not-prose border-y border-white/10">
    <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6 md:py-12">
      <p class="section-kicker">Board Application</p>
      <h1 class="mt-5 max-w-3xl font-heading text-4xl font-semibold leading-[1.04] text-white md:text-5xl">
        Serve HTA
      </h1>
      <p class="mt-5 max-w-3xl text-lg leading-relaxed text-white/80 md:text-xl">
        Complete the application below. We review submissions on a rolling basis.
      </p>
    </div>
  </section>

  <section class="px-4 py-14 sm:px-6 md:py-16 mx-auto max-w-5xl not-prose">
    <div class="mb-8 max-w-3xl">
      <p class="section-kicker">Board Service</p>
      <h2 class="mt-5 font-heading text-4xl font-semibold leading-[1.02] md:text-5xl">Rolling application review</h2>
      <p class="mt-4 text-lg leading-relaxed text-muted">
        Use this form to share your background, areas of expertise, and interest in supporting HTA's nonprofit
        governance.
      </p>
    </div>
    <div class="paper-panel p-2 sm:p-4">
      <iframe
        src="https://docs.google.com/forms/d/e/1FAIpQLSc0Pj5z_OkO5SkjWi8jH2iyhtAc7Y6epPmPq6MrngoglqHQqA/viewform?embedded=true"
        width="100%"
        height="2000"
        title="HTA Board Application"
      >
        Loading...
      </iframe>
    </div>
  </section>
</Layout>

<style>
  .board-app-hero {
    background: linear-gradient(90deg, rgba(8, 112, 134, 0.24), transparent 38%), var(--hta-hero-bg);
  }
</style>
